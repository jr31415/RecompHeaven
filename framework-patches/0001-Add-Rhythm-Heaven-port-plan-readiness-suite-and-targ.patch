+#!/usr/bin/env python3
+"""Rhythm Heaven port readiness suite (Windows / macOS / Linux).
+
+Stdlib only. Run from anywhere:
+
+    python tools/rh_suite.py --rom "path/to/Rhythm Heaven (US).nds"
+    python tools/rh_suite.py --rom <rom> --only env,rom      # subset
+    python tools/rh_suite.py --rom <rom> --runner             # + runner build
+
+It checks artifacts and build health only. It does not run gameplay and it
+does not benchmark (see AGENTS.md). The ROM is read, never copied into the
+repo; all output goes to --work (default build-suite/), which is gitignored.
+
+Result per check: PASS | FAIL | WARN | SKIP. Exit status is 1 if any FAIL.
+Send back <work>/report.json (no ROM content, no paths outside the repo
+other than the ones you pass) after running on a new machine.
+"""
+import argparse
+import hashlib
+import json
+import os
+import platform
+import shutil
+import struct
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+EXE = ".exe" if os.name == "nt" else ""
+
+RH_SHA1 = "601b92b1603f1822543e264df55ab4152ded356c"
+RH_GAMECODE = b"YLZE"
+RH_ARM9 = dict(off=0x4000, size=0x53B98, load=0x02000000, entry=0x02000800)
+RH_ARM7 = dict(off=0x15D400, size=0x26F28, load=0x02380000, entry=0x02380000)
+RH_OVL9 = dict(table=0x57C00, size=0x14A0)
+RH_EXPECT_OVERLAYS = 165
+RH_EXPECT_SLOTS = {0x0228FA60: 105, 0x02287660: 59, 0x0227CB20: 1}
+BIOS_SHA1 = {
+    "biosnds9.rom": "bfaac75f101c135e32e2aaf541de6b1be4c8c62d",
+    "biosnds7.rom": "24f67bdea115a2c847c8813a262502ee1607b7df",
+    "firmware.bin": "ae22de59fbf3f35ccfbeacaeba6fa87ac5e7b14b",
+}
+FREEBIOS_SHA1 = {
+    "drastic_bios_arm9.bin": "b85d6afdbf65d87c9ab11d4e7fb5ecfd6192ccf8",
+    "drastic_bios_arm7.bin": "eaab9b21610978f05a0eb14a9c8ff345698f56a2",
+}
+
+results = []
+
+
+def record(group, name, status, detail="", secs=None):
+    results.append(dict(group=group, name=name, status=status,
+                        detail=detail, secs=None if secs is None else round(secs, 2)))
+    tag = {"PASS": "PASS", "FAIL": "FAIL", "WARN": "WARN", "SKIP": "skip"}[status]
+    line = f"  [{tag}] {group}/{name}"
+    if detail:
+        line += f" - {detail}"
+    print(line, flush=True)
+
+
+def sha1_file(p):
+    h = hashlib.sha1()
+    with open(p, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def run(cmd, cwd=None, timeout=1800, env=None):
+    t = time.time()
+    try:
+        p = subprocess.run([str(c) for c in cmd], cwd=cwd, env=env, timeout=timeout,
+                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
+                           errors="replace")
+        return p.returncode, p.stdout, time.time() - t
+    except FileNotFoundError as e:
+        return 127, str(e), time.time() - t
+    except subprocess.TimeoutExpired as e:
+        return 124, f"timeout after {timeout}s\n{e.stdout or ''}", time.time() - t
+
+
+def tail(text, n=6):
+    return " | ".join(l for l in text.strip().splitlines()[-n:])
+
+
+# ── env ─────────────────────────────────────────────────────────────────
+def find_c_compiler(override):
+    for c in ([override] if override else ["clang", "gcc", "cc", "cl"]):
+        if c and shutil.which(c):
+            return shutil.which(c)
+    return None
+
+
+def stage_env(ctx):
+    g = "env"
+    record(g, "platform", "PASS",
+           f"{platform.system()} {platform.release()} {platform.machine()}, "
+           f"python {platform.python_version()}")
+    if sys.version_info < (3, 8):
+        record(g, "python>=3.8", "FAIL", platform.python_version())
+    for t in ("cmake", "ninja", "git"):
+        p = shutil.which(t)
+        if not p:
+            record(g, t, "FAIL" if t == "cmake" else "WARN", "not on PATH")
+        else:
+            rc, out, _ = run([p, "--version"])
+            record(g, t, "PASS", out.splitlines()[0] if out else p)
+    cc = find_c_compiler(ctx.cc)
+    ctx.cc = cc
+    cxx = shutil.which("clang++") or shutil.which("g++") or shutil.which("c++") or shutil.which("cl")
+    ctx.cxx = cxx
+    if cc and cxx:
+        rc, out, _ = run([cc, "--version"] if not cc.lower().endswith("cl.exe") else [cc])
+        record(g, "c/c++ compiler", "PASS", f"{Path(cc).name}, {Path(cxx).name}: "
+               f"{(out.splitlines() or [''])[0]}")
+    else:
+        record(g, "c/c++ compiler", "FAIL", "need clang/gcc (mingw64 on Windows) on PATH")
+    free = shutil.disk_usage(ctx.work.parent if ctx.work.parent.exists() else REPO).free
+    record(g, "free disk", "PASS" if free > 5 << 30 else "WARN", f"{free >> 30} GiB")
+    if "iCloud" in str(REPO) or "Mobile Documents" in str(REPO):
+        record(g, "repo location", "WARN",
+               "repo is under iCloud Drive; pass --work outside it for big builds")
+    core = REPO / "external/arm-recomp-core/CMakeLists.txt"
+    record(g, "submodule arm-recomp-core", "PASS" if core.exists() else "FAIL",
+           "" if core.exists() else "run: git submodule update --init --recursive")
+    fb = REPO / "third_party/freebios/drastic_bios_arm9.bin"
+    record(g, "submodule freebios", "PASS" if fb.exists() else "WARN",
+           "" if fb.exists() else "git submodule update --init (dump-free boot path)")
+
+
+# ── inputs ──────────────────────────────────────────────────────────────
+def find_rom(arg):
+    cands = [arg] if arg else []
+    cands += [os.environ.get("RH_ROM")]
+    cands += [str(p) for p in REPO.glob("*.nds")]
+    for c in cands:
+        if c and Path(c).is_file():
+            return Path(c)
+    return None
+
+
+def stage_rom(ctx):
+    g = "rom"
+    rom = find_rom(ctx.rom_arg)
+    if not rom:
+        record(g, "rom present", "FAIL", "pass --rom <file> or set RH_ROM")
+        return
+    ctx.rom = rom
+    data = rom.read_bytes()
+    ctx.rom_data = data
+    record(g, "rom present", "PASS", f"{len(data) >> 20} MiB")
+    sha = hashlib.sha1(data).hexdigest()
+    record(g, "sha1", "PASS" if sha == RH_SHA1 else "WARN",
+           sha if sha == RH_SHA1 else f"{sha} (expected {RH_SHA1}; other dump/revision - "
+           "the checks below still run but the pinned identity will not match)")
+    title, code = data[0:12], data[12:16]
+    ok = code == RH_GAMECODE and title.startswith(b"RHYTHM")
+    record(g, "header", "PASS" if ok else "FAIL",
+           f"title={title!r} code={code!r} unit={data[0x12]}")
+    a9 = struct.unpack("<IIII", data[0x20:0x30])
+    a7 = struct.unpack("<IIII", data[0x30:0x40])
+    hdr_ok = (a9 == (RH_ARM9["off"], RH_ARM9["entry"], RH_ARM9["load"], RH_ARM9["size"]) and
+              a7 == (RH_ARM7["off"], RH_ARM7["entry"], RH_ARM7["load"], RH_ARM7["size"]))
+    record(g, "arm9/arm7 layout", "PASS" if hdr_ok else "WARN",
+           f"arm9={[hex(x) for x in a9]} arm7={[hex(x) for x in a7]}")
+    ctx.arm9 = data[a9[0]:a9[0] + a9[3]]
+    ctx.arm7 = data[a7[0]:a7[0] + a7[3]]
+    ctx.a9 = dict(off=a9[0], entry=a9[1], load=a9[2], size=a9[3])
+    ctx.a7 = dict(off=a7[0], entry=a7[1], load=a7[2], size=a7[3])
+
+    # secure area normal form
+    sa = data[0x4000:0x4008]
+    form = ("encrypted" if sa == b"encryObj" else
+            "decrypted" if sa == bytes.fromhex("ffdeffe7ffdeffe7") else "unknown")
+    record(g, "secure area", "PASS" if form != "unknown" else "WARN", form)
+
+    # module params: compressed static?
+    i = ctx.arm9.find(bytes.fromhex("2106c0de"))
+    if i >= 0x1C:
+        mp = struct.unpack("<9I", ctx.arm9[i - 0x1C:i + 8])
+        comp = mp[5]
+        record(g, "arm9 static compression", "PASS" if comp == 0 else "FAIL",
+               "uncompressed" if comp == 0 else f"compressed_static_end={comp:#x}")
+        al_lo, al_hi = mp[0] - ctx.a9["load"], mp[1] - ctx.a9["load"]
+        n = (al_hi - al_lo) // 12
+        blocks = [struct.unpack("<III", ctx.arm9[al_lo + 12 * k:al_lo + 12 * k + 12])
+                  for k in range(n)]
+        ctx.autoload = blocks
+        record(g, "autoload blocks", "PASS",
+               ", ".join(f"{a:#x}+{s:#x}(+bss {b:#x})" for a, s, b in blocks))
+    else:
+        record(g, "module params", "FAIL", "nitrocode marker not found in ARM9 image")
+
+    # overlays
+    t = struct.unpack("<I", data[0x50:0x54])[0]
+    n = struct.unpack("<I", data[0x54:0x58])[0]
+    cnt = n // 32
+    ents = [struct.unpack("<IIIIIIII", data[t + 32 * k:t + 32 * k + 32]) for k in range(cnt)]
+    ctx.overlays = ents
+    slots = {}
+    for e in ents:
+        slots[e[1]] = slots.get(e[1], 0) + 1
+    comp = sum(1 for e in ents if e[7] >> 24 & 1)
+    record(g, "arm9 overlays", "PASS" if cnt == RH_EXPECT_OVERLAYS else "WARN", f"{cnt}")
+    record(g, "overlay ram slots", "PASS" if slots == RH_EXPECT_SLOTS else "WARN",
+           ", ".join(f"{a:#x}x{c}" for a, c in sorted(slots.items())))
+    record(g, "overlays compressed", "PASS" if comp == 0 else "FAIL",
+           f"{comp} compressed (recompile needs decompression first)" if comp else "0")
+    # file bounds
+    FAT = struct.unpack("<II", data[0x48:0x50])
+    bad = 0
+    # overlay table word 6 is the FAT file id
+    for e in ents:
+        fid = e[6]
+        s, en = struct.unpack("<II", data[FAT[0] + 8 * fid:FAT[0] + 8 * fid + 8])
+        if not (0 < s < en <= len(data)) or en - s < e[2]:
+            bad += 1
+    record(g, "overlay file bounds", "PASS" if bad == 0 else "FAIL", f"{bad} bad of {cnt}")
+    if ctx.rom_dir_is_repo():
+        record(g, "rom location", "WARN" if not ctx.rom_ignored() else "PASS",
+               "ROM sits inside the repo; *.nds must be gitignored before any commit")
+
+
+def stage_bios(ctx):
+    g = "bios"
+    bdir = REPO / "bios"
+    have = {n: (bdir / n) for n in BIOS_SHA1 if (bdir / n).is_file()}
+    if not have:
+        record(g, "retail dumps", "WARN",
+               "none in bios/ - faithful/oracle path unavailable; FreeBIOS path only")
+    for n, p in have.items():
+        s = sha1_file(p)
+        record(g, n, "PASS" if s == BIOS_SHA1[n] else "FAIL", s)
+    fdir = REPO / "third_party/freebios"
+    for n, want in FREEBIOS_SHA1.items():
+        p = fdir / n
+        if p.is_file():
+            s = sha1_file(p)
+            record(g, "freebios/" + n, "PASS" if s == want else "FAIL", s)
+        else:
+            record(g, "freebios/" + n, "SKIP", "submodule not initialised")
+
+
+# ── recompiler ──────────────────────────────────────────────────────────
+def stage_recompiler(ctx):
+    g = "recompiler"
+    if not shutil.which("cmake"):
+        record(g, "configure", "SKIP", "cmake missing")
+        return
+    bdir = ctx.work / "recompiler-build"
+    gen = []
+    if shutil.which("ninja"):
+        gen = ["-G", "Ninja"]
+    elif os.name == "nt" and shutil.which("mingw32-make"):
+        gen = ["-G", "MinGW Makefiles"]
+    cfg = ["cmake", *gen, "-S", REPO / "recompiler", "-B", bdir,
+           "-DCMAKE_BUILD_TYPE=Release"]
+    if ctx.cc:
+        cfg.append(f"-DCMAKE_C_COMPILER={ctx.cc}")
+    if ctx.cxx:
+        cfg.append(f"-DCMAKE_CXX_COMPILER={ctx.cxx}")
+    rc, out, dt = run(cfg)
+    record(g, "configure", "PASS" if rc == 0 else "FAIL", tail(out, 3) if rc else "", dt)
+    if rc:
+        return
+    rc, out, dt = run(["cmake", "--build", bdir, "--parallel", str(os.cpu_count() or 4)])
+    record(g, "build", "PASS" if rc == 0 else "FAIL", tail(out, 4) if rc else "", dt)
+    if rc:
+        return
+    ctx.nds_recompile = bdir / ("nds_recompile" + EXE)
+    if not ctx.nds_recompile.exists():  # multi-config generators
+        for sub in ("Release", "Debug"):
+            if (bdir / sub / ("nds_recompile" + EXE)).exists():
+                ctx.nds_recompile = bdir / sub / ("nds_recompile" + EXE)
+    exe = lambda n: ctx.nds_recompile.parent / (n + EXE)
+    tw = ctx.work / "recompiler-tests"
+    shutil.rmtree(tw, ignore_errors=True)
+    tw.mkdir(parents=True)
+    tests = [
+        ("armv5te_decode_test", []),
+        ("interpreter_cycle_test", []),
+        ("hle_manifest_test", []),
+        ("codegen_golden_test", [ctx.nds_recompile, tw / "golden",
+                                 REPO / "recompiler/tests/codegen_golden.txt"]),
+        ("interior_entry_fail_closed_test", [ctx.nds_recompile, tw / "interior"]),
+        ("live_transfer_validation_test", [ctx.nds_recompile, tw / "live"]),
+    ]
+    for name, args in tests:
+        if not exe(name).exists():
+            record(g, name, "SKIP", "binary not built")
+            continue
+        for a in args:
+            if isinstance(a, Path) and a.suffix == "" and "golden" not in a.name \
+                    and a != ctx.nds_recompile:
+                a.mkdir(parents=True, exist_ok=True)
+        rc, out, dt = run([exe(name), *args], cwd=REPO / "recompiler")
+        record(g, name, "PASS" if rc == 0 else "FAIL", tail(out, 4) if rc else "", dt)
+
+
+# ── recompile the ROM's code, compile the C ─────────────────────────────
+def toml_for(id_, name, cpu, isa, load, size, entry, sha1, extra=""):
+    return (f'[program]\nname = "{name}"\nid = "{id_}"\ncpu = "{cpu}"\nisa = "{isa}"\n'
+            f'load_address = {load:#010x}\nsize = {size:#010x}\nentry_pc = {entry:#010x}\n\n'
+            f'[identity]\nsha1 = "{sha1}"\n\n[[entry_point]]\naddr = {entry:#010x}\n'
+            f'mode = "arm"\nname = "_start"\n{extra}')
+
+
+def include_args(ctx):
+    incs = [REPO / "recompiler/armv4t", REPO / "external/arm-recomp-core/common",
+            REPO / "external/arm-recomp-core/armv4t"]
+    return [f"-I{p}" for p in incs if p.exists()]
+
+
+def compile_c(ctx, src, obj):
+    if ctx.cc and Path(ctx.cc).name.lower() in ("cl", "cl.exe"):
+        return run([ctx.cc, "/nologo", "/c", "/std:c11", *[a.replace("-I", "/I") for a in include_args(ctx)],
+                    f"/Fo{obj}", src])
+    return run([ctx.cc, "-std=c11", "-O0", "-c", *include_args(ctx), "-o", obj, src])
+
+
+def recomp_one(ctx, g, label, cpu, isa, blob, load, entry, tag):
+    wd = ctx.work / "rom-banks" / tag
+    shutil.rmtree(wd, ignore_errors=True)
+    (wd / "out").mkdir(parents=True)
+    (wd / f"{tag}.bin").write_bytes(blob)
+    sha = hashlib.sha1(blob).hexdigest()
+    cfg = wd / f"{tag}.toml"
+    cfg.write_text(toml_for(tag, label, cpu, isa, load, len(blob), entry, sha))
+    rc, out, dt = run([ctx.nds_recompile, "--config", cfg, "--bin", wd / f"{tag}.bin", "--audit"])
+    gaps = False
+    if "NOT-IMPLEMENTED ops" in out:
+        after = out.split("NOT-IMPLEMENTED ops", 1)[1].splitlines()[1:3]
+        gaps = not any("(none)" in l for l in after)
+    funcs = next((l.strip() for l in out.splitlines() if l.startswith("[finder] functions=")), "")
+    record(g, f"{tag} audit", "PASS" if rc == 0 and not gaps and funcs else "FAIL",
+           funcs or tail(out, 2), dt)
+    if rc:
+        return
+    rc, out, dt = run([ctx.nds_recompile, "--config", cfg, "--bin", wd / f"{tag}.bin",
+                       "--out", wd / "out", "--bank", tag])
+    srcs = sorted((wd / "out").glob("*.c"))
+    record(g, f"{tag} emit", "PASS" if rc == 0 and srcs else "FAIL",
+           f"{len(srcs)} C files, {sum(s.stat().st_size for s in srcs) >> 10} KiB", dt)
+    if not (rc == 0 and srcs and ctx.cc):
+        return
+    bad = []
+    t = time.time()
+    for s in srcs:
+        r, o, _ = compile_c(ctx, s, wd / (s.stem + ".o"))
+        if r:
+            bad.append(f"{s.name}: {tail(o, 2)}")
+    record(g, f"{tag} C compile", "PASS" if not bad else "FAIL",
+           "" if not bad else bad[0], time.time() - t)
+
+
+def stage_rom_recompile(ctx):
+    g = "rom-recompile"
+    if not getattr(ctx, "rom_data", None):
+        record(g, "all", "SKIP", "no ROM")
+        return
+    if not getattr(ctx, "nds_recompile", None):
+        record(g, "all", "SKIP", "recompiler not built")
+        return
+    recomp_one(ctx, g, "Rhythm Heaven ARM9 static", "arm9", "armv5te", ctx.arm9,
+               ctx.a9["load"], ctx.a9["entry"], "rh_arm9")
+    recomp_one(ctx, g, "Rhythm Heaven ARM7", "arm7", "armv4t", ctx.arm7,
+               ctx.a7["load"], ctx.a7["entry"], "rh_arm7")
+    # Overlays: every one must decode with zero gaps. Overlays are plain
+    # uncompressed bytes, so they can be audited straight from the ROM.
+    ov_dir = ctx.work / "rom-banks" / "overlays"
+    shutil.rmtree(ov_dir, ignore_errors=True)
+    ov_dir.mkdir(parents=True)
+    FAT = struct.unpack("<II", ctx.rom_data[0x48:0x50])[0]
+    failed, undef_ovs, total_funcs, t0 = [], [], 0, time.time()
+    for e in ctx.overlays:
+        ovid, ram, size, fid = e[0], e[1], e[2], e[6]
+        s, en = struct.unpack("<II", ctx.rom_data[FAT + 8 * fid:FAT + 8 * fid + 8])
+        blob = ctx.rom_data[s:s + size]
+        tag = f"ov{ovid:03d}"
+        (ov_dir / f"{tag}.bin").write_bytes(blob)
+        (ov_dir / f"{tag}.toml").write_text(toml_for(
+            tag, f"RH overlay {ovid}", "arm9", "armv5te", ram, len(blob), ram,
+            hashlib.sha1(blob).hexdigest()))
+        rc, out, _ = run([ctx.nds_recompile, "--config", ov_dir / f"{tag}.toml",
+                          "--bin", ov_dir / f"{tag}.bin", "--audit"], timeout=300)
+        m = next((l for l in out.splitlines() if l.startswith("[finder] functions=")), "")
+        gap = False
+        if "NOT-IMPLEMENTED ops" in out:
+            after = out.split("NOT-IMPLEMENTED ops", 1)[1].splitlines()[1:3]
+            gap = not any("(none)" in l for l in after)
+        if rc != 0 or not m or gap:
+            failed.append(f"{tag}: rc={rc} gap={gap}")
+            continue
+        total_funcs += int(m.split("functions=")[1].split()[0])
+        if "undefined=0" not in m:
+            undef_ovs.append(tag)
+    record(g, "overlays audit", "PASS" if not failed else "FAIL",
+           f"{len(ctx.overlays) - len(failed)}/{len(ctx.overlays)} decode with no codegen gaps, "
+           f"{total_funcs} fns" + ("" if not failed else f"; first fail: {failed[0]}"),
+           time.time() - t0)
+    if undef_ovs:
+        record(g, "overlays undecoded words", "WARN",
+               f"{len(undef_ovs)} overlays hit non-instruction words during entry-only "
+               "discovery (typically strings/literal pools); informational")
+    record(g, "coverage note", "WARN",
+           "entry-only discovery; ARM9 has many indirect calls (vtables). "
+           "Real coverage comes from Phase 3 (runtime captures + per-overlay entry maps).")
+
+
+# ── runner (opt-in; expected to fail until the macOS port lands) ────────
+def stage_runner(ctx):
+    g = "runner"
+    if not ctx.runner:
+        record(g, "build", "SKIP", "pass --runner to attempt")
+        return
+    gen = REPO / "generated"
+    need = ["arm9_bios.c", "arm7_bios.c"]
+    free_ok = all((REPO / "third_party/freebios" / n).exists()
+                  for n in FREEBIOS_SHA1)
+    have_dumps = all((REPO / "bios" / n).exists() for n in ("biosnds9.rom", "biosnds7.rom"))
+    if not (free_ok or have_dumps):
+        record(g, "inputs", "SKIP", "neither retail dumps nor FreeBIOS binaries present")
+        return
+    bdir = ctx.work / "runner-build"
+    cfg = ["cmake", "-S", REPO / "runner", "-B", bdir, "-DCMAKE_BUILD_TYPE=Release",
+           "-DNDS_SDL_BACKEND=NONE", "-DNDS_BOOTSTRAP_FIRMWARE=ON",
+           f"-DNDS_GENERATED_DIR={ctx.work / 'generated'}"]
+    if shutil.which("ninja"):
+        cfg[1:1] = ["-G", "Ninja"]
+    (ctx.work / "generated").mkdir(parents=True, exist_ok=True)
+    if not ctx.nds_recompile:
+        record(g, "bios banks", "SKIP", "recompiler not built")
+        return
+    jobs = []
+    if have_dumps:
+        jobs += [("arm9_bios", "biosnds9"), ("arm7_bios", "biosnds7")]
+        src = lambda b: REPO / "bios" / (b + ".rom")
+    for bank, base in jobs:
+        rc, out, dt = run([ctx.nds_recompile, "--config", REPO / "bios" / (base + ".toml"),
+                           "--bin", src(base), "--out", ctx.work / "generated", "--bank", bank])
+        record(g, f"emit {bank}", "PASS" if rc == 0 else "FAIL", tail(out, 2) if rc else "", dt)
+    if not have_dumps:
+        record(g, "bios banks", "SKIP",
+               "FreeBIOS bank generation needs the freebios arm9/arm7 configs wired; "
+               "see docs/rhythm-heaven-plan.md Phase 1")
+        return
+    rc, out, dt = run(cfg)
+    record(g, "configure", "PASS" if rc == 0 else "FAIL", tail(out, 5) if rc else "", dt)
+    if rc:
+        return
+    rc, out, dt = run(["cmake", "--build", bdir, "--parallel", str(os.cpu_count() or 4)],
+                      timeout=3600)
+    record(g, "build", "PASS" if rc == 0 else "FAIL", tail(out, 5) if rc else "", dt)
+
+
+# ── driver ──────────────────────────────────────────────────────────────
+class Ctx:
+    cc = cxx = None
+    nds_recompile = None
+    rom = None
+    rom_data = None
+    work = None
+
+    def rom_ignored(self):
+        rc, _, _ = run(["git", "check-ignore", "-q", str(self.rom)], cwd=REPO)
+        return rc == 0
+
+    def rom_dir_is_repo(self):
+        try:
+            self.rom.resolve().relative_to(REPO)
+            return True
+        except ValueError:
+            return False
+
+
+STAGES = [("env", stage_env), ("rom", stage_rom), ("bios", stage_bios),
+          ("recompiler", stage_recompiler), ("rom-recompile", stage_rom_recompile),
+          ("runner", stage_runner)]
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--rom")
+    ap.add_argument("--work", default=str(REPO / "build-suite"))
+    ap.add_argument("--only", help="comma list of: " + ",".join(n for n, _ in STAGES))
+    ap.add_argument("--cc", help="C compiler override")
+    ap.add_argument("--runner", action="store_true", help="also attempt the runner build")
+    a = ap.parse_args()
+    ctx = Ctx()
+    ctx.rom_arg, ctx.cc, ctx.runner = a.rom, a.cc, a.runner
+    ctx.work = Path(a.work).resolve()
+    ctx.work.mkdir(parents=True, exist_ok=True)
+    only = set(a.only.split(",")) if a.only else None
+    t0 = time.time()
+    print(f"rh_suite: repo={REPO}\n          work={ctx.work}")
+    for name, fn in STAGES:
+        if only and name not in only:
+            continue
+        # later stages need earlier context even if not selected
+        print(f"== {name}")
+        try:
+            fn(ctx)
+        except Exception as e:  # a crash in a stage is a failure, not a pass
+            record(name, "stage crashed", "FAIL", f"{type(e).__name__}: {e}")
+        if name == "env" and not ctx.cc:
+            find_c_compiler(None)
+    counts = {s: sum(1 for r in results if r["status"] == s)
+              for s in ("PASS", "FAIL", "WARN", "SKIP")}
+    report = dict(
+        when=time.strftime("%Y-%m-%dT%H:%M:%S"),
+        machine=dict(system=platform.system(), release=platform.release(),
+                     arch=platform.machine(), python=platform.python_version()),
+        rom_sha1=hashlib.sha1(ctx.rom_data).hexdigest() if ctx.rom_data else None,
+        git_head=run(["git", "rev-parse", "--short", "HEAD"], cwd=REPO)[1].strip(),
+        counts=counts, seconds=round(time.time() - t0, 1), results=results)
+    (ctx.work / "report.json").write_text(json.dumps(report, indent=2))
+    print(f"\n{counts['PASS']} pass, {counts['FAIL']} fail, {counts['WARN']} warn, "
+          f"{counts['SKIP']} skip  ({report['seconds']}s)\nreport: {ctx.work / 'report.json'}")
+    return 1 if counts["FAIL"] else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
