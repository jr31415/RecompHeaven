+// Rotated stacked layout. The logical canvas is 384x256 for 90/270 (two
+// 192x256 footprints side by side) or 256x384 for 180. At 270 (CCW quarter
+// turn, the book-style grip) the top screen is on the left; at 90 it is on the
+// right; at 180 it is below the bottom screen.
+bool rotation_is_quarter(int rotation) {
+    return rotation == 90 || rotation == 270;
+}
+
+void rotated_canvas_size(int rotation, int canvas_width, int* w, int* h) {
+    if (rotation_is_quarter(rotation)) {
+        *w = kScreenHeight * 2;
+        *h = kScreenWidth;
+    } else {
+        *w = canvas_width;
+        *h = kScreenHeight * 2;
+    }
+}
+
+SDL_Rect rotated_footprint(int rotation, int screen) {
+    if (rotation == 270)
+        return SDL_Rect{screen == 0 ? 0 : kScreenHeight, 0, kScreenHeight,
+                        kScreenWidth};
+    if (rotation == 90)
+        return SDL_Rect{screen == 0 ? kScreenHeight : 0, 0, kScreenHeight,
+                        kScreenWidth};
+    return SDL_Rect{0, screen == 0 ? kScreenHeight : 0, kScreenWidth,
+                    kScreenHeight};
+}
+
+// The unrotated 256x192 rectangle whose rotation about its centre lands on the
+// footprint.
+SDL_Rect rotated_draw_rect(int rotation, int screen) {
+    const SDL_Rect foot = rotated_footprint(rotation, screen);
+    const int cx = foot.x + foot.w / 2;
+    const int cy = foot.y + foot.h / 2;
+    return SDL_Rect{cx - kScreenWidth / 2, cy - kScreenHeight / 2,
+                    kScreenWidth, kScreenHeight};
+}
+
+// Inverse mapping: a point in the rotated logical canvas -> the equivalent
+// point in the unrotated stacked canvas, so all touch routing downstream is
+// unchanged. Points outside both footprints map far outside the canvas.
+void unrotate_point(int rotation, int canvas_width, float lx, float ly,
+                    float* ox, float* oy) {
+    *ox = -10000.0f;
+    *oy = -10000.0f;
+    for (int screen = 0; screen < 2; ++screen) {
+        const SDL_Rect foot = rotated_footprint(rotation, screen);
+        const float px = lx - static_cast<float>(foot.x);
+        const float py = ly - static_cast<float>(foot.y);
+        if (px < 0 || py < 0 || px >= static_cast<float>(foot.w) ||
+            py >= static_cast<float>(foot.h))
+            continue;
+        // Mouse positions are continuous, so the inverse uses the screen
+        // size, not size-1 (that form is for integer pixel indices).
+        float sx = 0, sy = 0;
+        if (rotation == 270) {
+            sx = static_cast<float>(kScreenWidth) - py;
+            sy = px;
+        } else if (rotation == 90) {
+            sx = py;
+            sy = static_cast<float>(kScreenHeight) - px;
+        } else {
+            sx = static_cast<float>(kScreenWidth) - px;
+            sy = static_cast<float>(kScreenHeight) - py;
+        }
+        sx = std::min(sx, static_cast<float>(kScreenWidth) - 0.001f);
+        sy = std::min(sy, static_cast<float>(kScreenHeight) - 0.001f);
+        *ox = sx + static_cast<float>((canvas_width - kScreenWidth) / 2);
+        *oy = sy + (screen == 1 ? static_cast<float>(kScreenHeight) : 0.0f);
+        return;
+    }
+}
+
+void unrotate_mouse_event(SDL_Event& event,
+                          const FrontendPresentation& presentation) {
+    if (presentation.rotation == 0) return;
+    float x = 0, y = 0, ox = 0, oy = 0;
+    if (event.type == SDL_MOUSEBUTTONDOWN || event.type == SDL_MOUSEBUTTONUP) {
+        x = static_cast<float>(event.button.x);
+        y = static_cast<float>(event.button.y);
+        unrotate_point(presentation.rotation, presentation.canvas_width,
+                       x, y, &ox, &oy);
+        event.button.x = static_cast<decltype(event.button.x)>(ox);
+        event.button.y = static_cast<decltype(event.button.y)>(oy);
+    } else if (event.type == SDL_MOUSEMOTION) {
+        x = static_cast<float>(event.motion.x);
+        y = static_cast<float>(event.motion.y);
+        unrotate_point(presentation.rotation, presentation.canvas_width,
+                       x, y, &ox, &oy);
+        event.motion.x = static_cast<decltype(event.motion.x)>(ox);
+        event.motion.y = static_cast<decltype(event.motion.y)>(oy);
+    }
+}
