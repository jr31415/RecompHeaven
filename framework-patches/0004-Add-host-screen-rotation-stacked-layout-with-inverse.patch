 struct PresentationTicks {
@@ -1976,16 +2109,26 @@ PresentationTicks present_screens(FrontendPresentation& presentation,
         start = SDL_GetPerformanceCounter();
         SDL_SetRenderDrawColor(renderer, 20, 20, 20, 255);
         SDL_RenderClear(renderer);
-        const SDL_Rect top_rect{
+        SDL_Rect top_rect{
             (presentation.canvas_width -
              presentation.screen_widths[0]) / 2,
             0, presentation.screen_widths[0], kScreenHeight};
-        const SDL_Rect bottom_rect{
+        SDL_Rect bottom_rect{
             (presentation.canvas_width -
              presentation.screen_widths[1]) / 2,
             kScreenHeight, presentation.screen_widths[1], kScreenHeight};
-        render_screen(presentation, 0, top_rect);
-        render_screen(presentation, 1, bottom_rect);
+        if (presentation.rotation != 0) {
+            const double angle = static_cast<double>(presentation.rotation);
+            render_screen(presentation, 0,
+                          rotated_draw_rect(presentation.rotation, 0), angle);
+            render_screen(presentation, 1,
+                          rotated_draw_rect(presentation.rotation, 1), angle);
+            bottom_rect = rotated_footprint(presentation.rotation, 1);
+            virtual_stylus_visible = false;  // overlay is unrotated
+        } else {
+            render_screen(presentation, 0, top_rect);
+            render_screen(presentation, 1, bottom_rect);
