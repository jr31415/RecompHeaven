+bool nds_parse_screen_rotation(const std::string& value, int* out) {
+    if (!out) return false;
+    std::string v = lower_ascii(value);
+    if (v == "0" || v == "none" || v == "off") { *out = 0; return true; }
+    if (v == "90" || v == "cw" || v == "right") { *out = 90; return true; }
+    if (v == "180") { *out = 180; return true; }
+    if (v == "270" || v == "-90" || v == "ccw" || v == "left") {
+        *out = 270;
+        return true;
+    }
+    return false;
+}
