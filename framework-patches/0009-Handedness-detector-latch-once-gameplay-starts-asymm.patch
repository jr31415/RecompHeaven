From 493754738f800790b21f65b424c2f4bfca2247fe Mon Sep 17 00:00:00 2001
From: jr31415 <jacob@rosen4.com>
Date: Sat, 10 Oct 2026 11:57:29 -0700
Subject: [PATCH 09/11] Handedness detector: latch once gameplay starts;
 asymmetric evidence

The first version re-voted every frame and reverted to right-handed inside
minigames, where left-handed mode flips only 2-6 of 128 sprites. Only the
extremes are evidence now: >=50% flipped is left (6 frames); <=6% on a menu
scene is right (30 frames). The decision latches when the game sets the
POWCNT1 screen-swap bit after a decision exists, since handedness can only
change at the title prompt.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 runner/src/frontend.cpp | 86 +++++++++++++++++++++++++++++------------
 1 file changed, 62 insertions(+), 24 deletions(-)

diff --git a/runner/src/frontend.cpp b/runner/src/frontend.cpp
index 1350726..7c3c920 100644
--- a/runner/src/frontend.cpp
+++ b/runner/src/frontend.cpp
@@ -1693,13 +1693,26 @@ SDL_Rect rotated_draw_rect(int rotation, int screen) {
 // sprites are ignored; the verdict is the share of remaining sprites with
 // attr1 bit 13 set. Measured on Rhythm Heaven's bottom screen: ~3-4% in
 // right-handed mode, ~80% in left-handed mode.
-int detect_left_handed_from_oam(int* used_out = nullptr,
-                                int* flipped_out = nullptr) {
-    // Judged per engine: one engine routinely holds a full table of parked,
-    // never-flipped sprites that would otherwise dilute the other's ratio.
-    int best_used = 0;
-    int best_flipped = 0;
-    int verdict = -1;
+// Evidence for the handedness latch, from OAM. Measured on Rhythm Heaven
+// (flipped = share of non-affine, non-disabled sprites with attr1 bit 13 set):
+//   left-handed : title/prompts/slots/file ~78-80%, game map ~12%,
+//                 minigames 2-6 of 128 sprites
+//   right-handed: 0-4% in every scene
+// so only the two extremes carry information: >= 50% is unmistakably left;
+// <= 6% on a menu scene is right. Anything between is "no evidence".
+// Judged per engine because one engine routinely holds a table of parked,
+// never-flipped sprites that would dilute the other's ratio.
+struct HandEvidence {
+    bool strong_left = false;
+    bool strong_right = false;
+    int used = 0;
+    int flipped = 0;
+};
+
+HandEvidence detect_hand_evidence_from_oam() {
+    HandEvidence ev;
+    bool any = false;
+    bool all_low = true;
     for (int engine = 0; engine < 2; ++engine) {
         const uint8_t* oam = nds_vram_renderer_oam(engine);
         if (!oam) continue;
@@ -1716,15 +1729,17 @@ int detect_left_handed_from_oam(int* used_out = nullptr,
             ++used;
             flipped += (a1 >> 13) & 1;
         }
-        if (used < 8) continue;
-        if (flipped * 2 >= used) verdict = 1;
-        else if (verdict < 0) verdict = 0;
-        if (flipped > best_flipped) { best_flipped = flipped; best_used = used; }
-        else if (best_used == 0) best_used = used;
+        if (used < 8) continue;  // too few sprites to judge this engine
+        any = true;
+        if (flipped * 2 >= used) ev.strong_left = true;
+        if (flipped * 100 > used * 6) all_low = false;
+        if (flipped >= ev.flipped) {
+            ev.flipped = flipped;
+            ev.used = used;
+        }
     }
-    if (used_out) *used_out = best_used;
-    if (flipped_out) *flipped_out = best_flipped;
-    return verdict;
+    ev.strong_right = any && !ev.strong_left && all_low;
+    return ev;
 }
 
 // Inverse mapping: a point in the rotated logical canvas -> the equivalent
@@ -2529,6 +2544,8 @@ int nds_run_interactive_frontend(const NdsFrontendOptions& initial_options) {
     }
     const int base_rotation = options.screen_rotation;
     bool hand_left = false;
+    bool hand_decided = false;
+    bool hand_locked = false;
     int hand_candidate = 0;
     int hand_agree = 0;
     std::fprintf(stderr, "[sdl] audio queue target=%u frames (~%.1f ms)\n",
@@ -4258,20 +4275,33 @@ int nds_run_interactive_frontend(const NdsFrontendOptions& initial_options) {
             touch_release_pending = false;
         }
 
-        if (auto_hand_rotation) {
-            int hand_used = 0, hand_flipped = 0;
-            const int verdict =
-                detect_left_handed_from_oam(&hand_used, &hand_flipped);
+        if (auto_hand_rotation && !hand_locked) {
+            const HandEvidence ev = detect_hand_evidence_from_oam();
             if (std::getenv("NDS_HAND_DEBUG") && (shown_frames % 120) == 0)
-                std::fprintf(stderr, "[hand] f%llu used=%d flipped=%d verdict=%d\n",
+                std::fprintf(stderr,
+                             "[hand] f%llu used=%d flipped=%d left=%d right=%d "
+                             "decided=%d locked=%d\n",
                              static_cast<unsigned long long>(shown_frames),
-                             hand_used, hand_flipped, verdict);
+                             ev.used, ev.flipped, ev.strong_left ? 1 : 0,
+                             ev.strong_right ? 1 : 0, hand_decided ? 1 : 0,
+                             hand_locked ? 1 : 0);
+            // The mode can only change on the title screen's prompt. Once a
+            // decision exists and gameplay starts (the game sets POWCNT1's
+            // screen-swap bit), latch it: minigame scenes carry too little
+            // sprite evidence to be allowed to vote.
+            const bool in_game = (nds_powercontrol9() & 0x8000u) != 0;
+            int verdict = -1;
+            if (ev.strong_left) verdict = 1;
+            else if (ev.strong_right && !in_game) verdict = 0;
             if (verdict >= 0) {
                 if (verdict == hand_candidate) ++hand_agree;
                 else { hand_candidate = verdict; hand_agree = 1; }
-                // Six agreeing frames (~100 ms) so a scene transition never
-                // flips the window; a real mode change is sticky.
-                if (hand_agree >= 6 && (verdict == 1) != hand_left) {
+                // Left is unmistakable: six frames. Right is the absence of a
+                // signal, so it must persist for half a second.
+                const int needed = verdict == 1 ? 6 : 30;
+                if (hand_agree >= needed &&
+                    (!hand_decided || (verdict == 1) != hand_left)) {
+                    hand_decided = true;
                     hand_left = verdict == 1;
                     const int effective =
                         (base_rotation + (hand_left ? 180 : 0)) % 360;
@@ -4282,6 +4312,14 @@ int nds_run_interactive_frontend(const NdsFrontendOptions& initial_options) {
                         presentation.rotation = effective;
                     }, false);
                 }
+            } else {
+                hand_agree = 0;
+            }
+            if (hand_decided && in_game) {
+                hand_locked = true;
+                std::fprintf(stderr, "[sdl] handedness locked (%s) for the "
+                                     "session: gameplay started\n",
+                             hand_left ? "left" : "right");
             }
         }
         // Latency: this frame's audio goes to the device NOW, before the
-- 
