+                        std::to_string(frames).c_str());
+    }
     device.stream = SDL_OpenAudioDeviceStream(
         SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &want, nullptr, nullptr);
+    if (device.stream) {
+        const SDL_AudioDeviceID id = SDL_GetAudioStreamDevice(device.stream);
+        SDL_AudioSpec got{};
+        int got_frames = 0;
+        if (SDL_GetAudioDeviceFormat(id, &got, &got_frames)) {
+            g_audio_probe.device_frames = got_frames;
+            g_audio_probe.device_freq = got.freq;
+        }
+        g_audio_probe.stream_freq = want.freq;
+        // OS IO buffer: the default (512 frames) is most of the OS-side delay.
+        uint32_t os_frames = 64;
+        if (const char* env = std::getenv("NDS_AUDIO_OS_BUFFER_FRAMES"))
+            os_frames = static_cast<uint32_t>(std::strtoul(env, nullptr, 10));
+        if (os_frames) {
+            uint32_t applied = 0;
+            if (nds_audio_set_os_buffer_frames(os_frames, &applied))
+                std::fprintf(stderr, "[sdl] audio OS buffer: requested %u, "
+                             "device now %u frames\n", os_frames, applied);
+            else
+                std::fprintf(stderr, "[sdl] audio OS buffer request (%u) "
+                             "not applied\n", os_frames);
+        }
+        if (const char* t = std::getenv("NDS_AUDIO_TEST"))
+            g_audio_probe.test_mode = t[0] == '1';
+        if (g_audio_probe.test_mode &&
+            !SDL_SetAudioPostmixCallback(id, audio_postmix_probe, nullptr))
+            std::fprintf(stderr, "[sdl] audio probe postmix failed: %s\n",
+                         SDL_GetError());
+    }
     if (device.stream &&
         !SDL_SetAudioStreamGetCallback(
             device.stream, audio_stream_underrun_callback, &queue)) {
@@ -2528,6 +2703,27 @@ int nds_run_interactive_frontend(const NdsFrontendOptions& initial_options) {
