diff --git a/runner/src/audio_device_info.cpp b/runner/src/audio_device_info.cpp
new file mode 100644
index 0000000..bc5f201
--- /dev/null
+++ b/runner/src/audio_device_info.cpp
@@ -0,0 +1,128 @@
+#include "audio_device_info.h"
+
+#include <cstring>
+
+#if defined(__APPLE__)
+#include <CoreAudio/CoreAudio.h>
+
+namespace {
+
+template <typename T>
+bool get_prop(AudioObjectID object, AudioObjectPropertySelector selector,
+              AudioObjectPropertyScope scope, T* value) {
+    AudioObjectPropertyAddress address{selector, scope,
+                                       kAudioObjectPropertyElementMain};
+    UInt32 size = sizeof(T);
+    return AudioObjectGetPropertyData(object, &address, 0, nullptr, &size,
+                                      value) == noErr;
+}
+
+}  // namespace
+
+bool nds_audio_system_info(NdsAudioSystemInfo* out) {
+    if (!out) return false;
+    *out = NdsAudioSystemInfo{};
+    AudioDeviceID device = kAudioObjectUnknown;
+    if (!get_prop(kAudioObjectSystemObject,
+                  kAudioHardwarePropertyDefaultOutputDevice,
+                  kAudioObjectPropertyScopeGlobal, &device) ||
+        device == kAudioObjectUnknown)
+        return false;
+    Float64 rate = 0;
+    UInt32 value = 0;
+    if (get_prop(device, kAudioDevicePropertyNominalSampleRate,
+                 kAudioObjectPropertyScopeGlobal, &rate))
+        out->sample_rate = rate;
+    if (get_prop(device, kAudioDevicePropertyBufferFrameSize,
+                 kAudioObjectPropertyScopeOutput, &value))
+        out->buffer_frames = value;
+    if (get_prop(device, kAudioDevicePropertyLatency,
+                 kAudioObjectPropertyScopeOutput, &value))
+        out->device_latency = value;
+    if (get_prop(device, kAudioDevicePropertySafetyOffset,
+                 kAudioObjectPropertyScopeOutput, &value))
+        out->safety_offset = value;
+    AudioValueRange range{};
+    {
+        AudioObjectPropertyAddress address{
+            kAudioDevicePropertyBufferFrameSizeRange,
+            kAudioObjectPropertyScopeOutput, kAudioObjectPropertyElementMain};
+        UInt32 size = sizeof(range);
+        if (AudioObjectGetPropertyData(device, &address, 0, nullptr, &size,
+                                       &range) == noErr)
+            out->min_buffer_frames = static_cast<uint32_t>(range.mMinimum);
+    }
+    {
+        AudioObjectPropertyAddress address{
+            kAudioDevicePropertyStreams, kAudioObjectPropertyScopeOutput,
+            kAudioObjectPropertyElementMain};
+        UInt32 size = 0;
+        if (AudioObjectGetPropertyDataSize(device, &address, 0, nullptr,
+                                           &size) == noErr &&
+            size >= sizeof(AudioStreamID)) {
+            AudioStreamID streams[8];
+            if (size > sizeof(streams)) size = sizeof(streams);
+            if (AudioObjectGetPropertyData(device, &address, 0, nullptr, &size,
+                                           streams) == noErr &&
+                get_prop(streams[0], kAudioStreamPropertyLatency,
+                         kAudioObjectPropertyScopeGlobal, &value))
+                out->stream_latency = value;
+        }
+    }
+    {
+        CFStringRef name = nullptr;
+        AudioObjectPropertyAddress address{
+            kAudioObjectPropertyName, kAudioObjectPropertyScopeGlobal,
+            kAudioObjectPropertyElementMain};
+        UInt32 size = sizeof(name);
+        if (AudioObjectGetPropertyData(device, &address, 0, nullptr, &size,
+                                       &name) == noErr && name) {
+            CFStringGetCString(name, out->name, sizeof(out->name),
+                               kCFStringEncodingUTF8);
+            CFRelease(name);
+        }
+    }
+    out->ok = true;
+    return true;
+}
+bool nds_audio_set_os_buffer_frames(uint32_t frames, uint32_t* applied) {
+    AudioDeviceID device = kAudioObjectUnknown;
+    if (!get_prop(kAudioObjectSystemObject,
+                  kAudioHardwarePropertyDefaultOutputDevice,
+                  kAudioObjectPropertyScopeGlobal, &device) ||
+        device == kAudioObjectUnknown)
+        return false;
+    AudioValueRange range{};
+    {
+        AudioObjectPropertyAddress address{
+            kAudioDevicePropertyBufferFrameSizeRange,
+            kAudioObjectPropertyScopeOutput, kAudioObjectPropertyElementMain};
+        UInt32 size = sizeof(range);
+        if (AudioObjectGetPropertyData(device, &address, 0, nullptr, &size,
+                                       &range) == noErr) {
+            if (frames < range.mMinimum) frames = static_cast<uint32_t>(range.mMinimum);
+            if (frames > range.mMaximum) frames = static_cast<uint32_t>(range.mMaximum);
+        }
+    }
+    AudioObjectPropertyAddress address{
+        kAudioDevicePropertyBufferFrameSize, kAudioObjectPropertyScopeGlobal,
+        kAudioObjectPropertyElementMain};
+    const UInt32 value = frames;
+    const OSStatus status = AudioObjectSetPropertyData(
+        device, &address, 0, nullptr, sizeof(value), &value);
+    UInt32 now = 0;
+    if (get_prop(device, kAudioDevicePropertyBufferFrameSize,
+                 kAudioObjectPropertyScopeOutput, &now) && applied)
+        *applied = now;
+    return status == noErr;
+}
+#else
+bool nds_audio_set_os_buffer_frames(uint32_t, uint32_t* applied) {
+    if (applied) *applied = 0;
+    return false;
+}
+bool nds_audio_system_info(NdsAudioSystemInfo* out) {
+    if (out) *out = NdsAudioSystemInfo{};
+    return false;
+}
+#endif
diff --git a/runner/src/audio_device_info.h b/runner/src/audio_device_info.h
new file mode 100644
index 0000000..cf3f428
--- /dev/null
+++ b/runner/src/audio_device_info.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstdint>
+
+// Operating-system view of the default output device, in frames at the
+// device's own sample rate. Used only by the audio-latency probe; nothing in
+// emulation depends on it. ok=false when the platform has no implementation.
+struct NdsAudioSystemInfo {
+    bool ok = false;
+    double sample_rate = 0.0;
+    uint32_t buffer_frames = 0;      // current IO buffer size
+    uint32_t device_latency = 0;     // kAudioDevicePropertyLatency
+    uint32_t safety_offset = 0;      // kAudioDevicePropertySafetyOffset
+    uint32_t stream_latency = 0;     // kAudioStreamPropertyLatency (stream 0)
+    uint32_t min_buffer_frames = 0;  // lowest size the device accepts
+    char name[128] = {0};
+};
+
+bool nds_audio_system_info(NdsAudioSystemInfo* out);
+
+// Ask the default output device for a smaller IO buffer (frames at the device
+// rate, clamped to what it accepts). The OS default (512 frames, ~11.6 ms at
+// 44.1 kHz) is a large share of total output latency. Returns the size the
+// device reports afterwards in *applied. Process-scoped on macOS: the hint
+// ends with the process.
+bool nds_audio_set_os_buffer_frames(uint32_t frames, uint32_t* applied);
