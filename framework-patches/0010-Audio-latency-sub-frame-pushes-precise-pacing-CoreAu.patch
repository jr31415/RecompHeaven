+#if defined(NDS_HAVE_SDL3)
+// Audio latency probe (NDS_AUDIO_TEST=1). Game audio is muted and a short click
+// is injected into the exact path game audio takes (push_audio -> SDL stream ->
+// device). The click is timestamped when it is handed to the stream and again
+// when it shows up in the device mix (SDL's postmix callback, the last place
+// software sees it before the OS). The remaining OS/hardware latency is read
+// from CoreAudio. Report via the `audio_latency` debug command.
+struct AudioProbeSample {
+    uint64_t push_ns = 0;
+    uint64_t mix_ns = 0;
+    uint32_t queued_frames = 0;
+};
+struct AudioProbe {
+    bool test_mode = false;
+    std::atomic<bool> armed{false};
+    std::atomic<uint64_t> push_ns{0};
+    std::atomic<uint32_t> queued{0};
+    std::mutex mutex;
+    std::vector<AudioProbeSample> samples;
+    uint64_t next_click_ns = 0;
+    int device_frames = 0;
+    int device_freq = 0;
+    int stream_freq = 0;
+    uint32_t queue_target = 0;
+    uint32_t device_frames_hint = 0;
+};
+AudioProbe g_audio_probe;
+
+void SDLCALL audio_postmix_probe(void*, const SDL_AudioSpec* spec,
+                                 float* buffer, int buflen) {
+    if (!g_audio_probe.armed.load(std::memory_order_acquire)) return;
+    const int count = buflen / static_cast<int>(sizeof(float));
+    const int channels = spec && spec->channels > 0 ? spec->channels : 2;
+    int first = -1;
+    for (int i = 0; i < count; ++i) {
+        if (std::fabs(buffer[i]) > 0.25f) { first = i / channels; break; }
+    }
+    if (first < 0) return;
+    const double rate = spec && spec->freq > 0 ? spec->freq : 48000;
+    const uint64_t now = SDL_GetTicksNS();
+    AudioProbeSample s;
+    s.push_ns = g_audio_probe.push_ns.load(std::memory_order_relaxed);
+    // The click sits `first` frames into this buffer.
+    s.mix_ns = now + static_cast<uint64_t>(first / rate * 1e9);
+    s.queued_frames = g_audio_probe.queued.load(std::memory_order_relaxed);
+    {
+        std::lock_guard<std::mutex> lock(g_audio_probe.mutex);
+        g_audio_probe.samples.push_back(s);
+    }
+    g_audio_probe.armed.store(false, std::memory_order_release);
+}
+#endif
+
 // Hand every SPU block produced so far to the audio device. Split from the
 // pacing sleep (throttle_audio) so the caller can push a frame's audio the
 // moment it is emulated, BEFORE a vsync-blocking present, instead of behind it.
@@ -1064,6 +1118,27 @@ bool push_audio(const NdsAudioDevice& device, AudioQueue& queue,
     for (;;) {
         const uint32_t frames = nds_spu_read_output(samples.data(), 1024);
         if (!frames) break;
+#if defined(NDS_HAVE_SDL3)
+        if (g_audio_probe.test_mode) {
+            // Mute the game; keep the same chunking and pacing as real audio.
+            std::memset(samples.data(), 0, frames * kAudioFrameBytes);
+            const uint64_t now = SDL_GetTicksNS();
+            if (!g_audio_probe.armed.load(std::memory_order_acquire) &&
+                now >= g_audio_probe.next_click_ns && frames >= 32) {
+                for (uint32_t i = 0; i < 32; ++i) {
+                    const int16_t v = ((i / 4) & 1) ? -24000 : 24000;
+                    samples[i * 2] = v;
+                    samples[i * 2 + 1] = v;
+                }
+                g_audio_probe.queued.store(audio_queue_count(device, queue),
+                                           std::memory_order_relaxed);
+                g_audio_probe.push_ns.store(SDL_GetTicksNS(),
+                                            std::memory_order_relaxed);
+                g_audio_probe.armed.store(true, std::memory_order_release);
+                g_audio_probe.next_click_ns = now + 300000000ull;
+            }
+        }
+#endif
         bool pushed = false;
         while (!pushed) {
 #if defined(NDS_HAVE_SDL3)
@@ -1119,10 +1194,27 @@ uint32_t throttle_audio(const NdsAudioDevice& device, AudioQueue& queue,
     // down while the emulator is running behind, so a slow stretch spends the
     // buffered runway instead of having it slept away.
     uint32_t queued = audio_queue_count(device, queue);
+#if defined(NDS_HAVE_SDL3)
+    // Sleep in proportion to how far above the floor the queue is, with
+    // sub-millisecond precision, and not at all when the excess is under a
+    // fraction of a millisecond. The old fixed SDL_Delay(1) was fine once per
+    // frame but, called per audio chunk, costs >= 1 ms of wall clock for each
+    // ~1 ms of emulated time, so the loop falls behind real time and the queue
+    // starves.
+    while (throttle && queued > pace_floor) {
+        const double excess_ms =
+            static_cast<double>(queued - pace_floor) * 1000.0 /
+            static_cast<double>(kAudioFrequency);
+        if (excess_ms < 0.4) break;
+        SDL_DelayPrecise(static_cast<uint64_t>(excess_ms * 0.8 * 1e6));
+        queued = audio_queue_count(device, queue);
+    }
+#else
     while (throttle && queued > pace_floor) {
         SDL_Delay(1);
         queued = audio_queue_count(device, queue);
     }
+#endif
     return queued;
 }
 
@@ -1135,19 +1227,20 @@ uint32_t drain_audio(const NdsAudioDevice& device, AudioQueue& queue,
 }
 
 // Steady-state audio queue target in 32768 Hz frames: the pacing floor, and so
-// the host-side audio latency. The old fixed 2048 (~63 ms) was tuned for crackle
+// the host-side audio latency (minimum; see the adaptive floor in the frontend
+// loop, which raises it after underruns). The old fixed 2048 (~63 ms) was tuned for crackle
 // safety on a loop that presented before it pushed audio. Rhythm games need the
 // sound as early as possible; override with NDS_AUDIO_QUEUE_FRAMES (256..4096).
 uint32_t audio_queue_target_frames() {
-    uint32_t value = 1024;
+    uint32_t value = 192;
     if (const char* env = std::getenv("NDS_AUDIO_QUEUE_FRAMES")) {
         const long parsed = std::strtol(env, nullptr, 10);
-        if (parsed >= 256 && parsed <= 4096)
+        if (parsed >= 64 && parsed <= 4096)
             value = static_cast<uint32_t>(parsed);
         else
             std::fprintf(stderr,
                          "[sdl] ignoring NDS_AUDIO_QUEUE_FRAMES=%s "
-                         "(expected 256..4096)\n", env);
+                         "(expected 64..4096)\n", env);
     }
     return value;
 }
@@ -1169,6 +1262,48 @@ struct FrameTimeRecord {
     uint32_t underruns = 0;    // cumulative
 };
 
+#if defined(NDS_HAVE_SDL3)
+std::string audio_latency_json() {
+    char buf[1400];
+    NdsAudioSystemInfo sys{};
+    nds_audio_system_info(&sys);
+    std::vector<AudioProbeSample> copy;
+    {
+        std::lock_guard<std::mutex> lock(g_audio_probe.mutex);
+        copy = g_audio_probe.samples;
+    }
+    double sum = 0, mn = 1e9, mx = 0, qsum = 0;
+    std::string list;
+    size_t shown = 0;
+    for (size_t i = copy.size() > 40 ? copy.size() - 40 : 0; i < copy.size(); ++i) {
+        const double ms = (copy[i].mix_ns - copy[i].push_ns) / 1e6;
+        sum += ms; qsum += copy[i].queued_frames;
+        mn = std::min(mn, ms); mx = std::max(mx, ms);
+        char item[64];
+        std::snprintf(item, sizeof(item), "%s[%.2f,%u]", shown ? "," : "", ms,
+                      copy[i].queued_frames);
+        list += item; ++shown;
+    }
+    const double n = shown ? static_cast<double>(shown) : 1.0;
+    std::snprintf(buf, sizeof(buf),
+        "{\"test_mode\":%d,\"samples\":%zu,\"push_to_mix_ms\":{\"mean\":%.3f,"
+        "\"min\":%.3f,\"max\":%.3f},\"queued_frames_mean\":%.1f,"
+        "\"queue_target\":%u,\"stream_freq\":%d,\"sdl_device_frames\":%d,"
+        "\"sdl_device_freq\":%d,\"device_frames_hint\":%u,"
+        "\"system\":{\"ok\":%d,\"name\":\"%s\",\"rate\":%.0f,"
+        "\"buffer_frames\":%u,\"min_buffer_frames\":%u,\"device_latency\":%u,"
+        "\"safety_offset\":%u,\"stream_latency\":%u},\"recent\":[",
+        g_audio_probe.test_mode ? 1 : 0, copy.size(), shown ? sum / n : 0.0,
+        shown ? mn : 0.0, mx, shown ? qsum / n : 0.0, g_audio_probe.queue_target,
+        g_audio_probe.stream_freq, g_audio_probe.device_frames,
+        g_audio_probe.device_freq, g_audio_probe.device_frames_hint,
+        sys.ok ? 1 : 0, sys.name, sys.sample_rate, sys.buffer_frames,
+        sys.min_buffer_frames, sys.device_latency, sys.safety_offset,
+        sys.stream_latency);
+    return std::string(buf) + list + "]}";
+}
+#endif
+
 void clear_audio_queue(const NdsAudioDevice& device, AudioQueue& queue) {
     if (!device) return;
 #if defined(NDS_HAVE_SDL3)
@@ -1208,8 +1343,48 @@ NdsAudioDevice open_audio_device(AudioQueue& queue,
                                  const SDL_AudioSpec& want) {
 #if defined(NDS_HAVE_SDL3)
     NdsAudioDevice device{};
+    // Device IO buffer. SDL's default is large enough to add many ms; ask for
+    // a small one. NDS_AUDIO_DEVICE_FRAMES overrides (0 = leave SDL's default).
+    {
+        uint32_t frames = 64;
+        if (const char* env = std::getenv("NDS_AUDIO_DEVICE_FRAMES"))
+            frames = static_cast<uint32_t>(std::strtoul(env, nullptr, 10));
+        g_audio_probe.device_frames_hint = frames;
+        if (frames)
