+// Run `fn` on the thread that owns the renderer: the dedicated presenter thread
+// when NDS_PRESENT_THREAD is on, otherwise the main thread.
+void run_on_presenter(std::function<void()> fn, bool wait) {
+    if (!g_presenter || !g_presenter->present_thread) {
+        run_on_main(std::move(fn), wait);
+        return;
+    }
+    auto done = std::make_shared<std::promise<void>>();
+    std::future<void> finished = done->get_future();
+    {
+        std::lock_guard<std::mutex> lock(g_presenter->mutex);
+        g_presenter->present_tasks.push_back(
+            [fn = std::move(fn), done]() mutable {
+                fn();
+                done->set_value();
+            });
+    }
+    g_presenter->cv.notify_all();
+    if (wait) finished.wait();
+}
