 elseif(NDS_SDL_BACKEND STREQUAL "NONE")
-    target_compile_definitions(nds_runner PRIVATE NDS_SDL_BACKEND_NAME="NONE")
+    target_compile_definitions(nds_runner PRIVATE NDS_SDL_BACKEND_NAME="NONE"
+        NDS_SDL_BACKEND_IS_NONE=1)
 else()
     message(FATAL_ERROR "NDS_SDL_BACKEND must be SDL3, SDL2, or NONE")
 endif()
@@ -802,12 +806,42 @@ endif()
 # macOS gives a process by default, faulting in ___chkstk_darwin before the
 # firmware hands off. Linux's 8 MB soft limit is raisable per-shell; the macOS
 # main thread size is fixed at link time, so ask for it here.
-if(APPLE)
+if(APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
     target_link_options(nds_runner PRIVATE -Wl,-stack_size,0x4000000)
     # Output-device latency introspection for the audio-latency probe.
     target_link_libraries(nds_runner PRIVATE "-framework CoreAudio"
         "-framework CoreFoundation")
 endif()
+if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # App bundle: SDL_RunApp (src/ios_launch.mm) owns UIApplicationMain; the
+    # emulation thread carries its own stack. The user's ROM is read from the
+    # app's Documents folder at run time; nothing game-derived is in this
+    # target other than the title banks the user built locally.
+    set(NDS_IOS_BUNDLE_ID "com.example.ndsrecomp" CACHE STRING
+        "CFBundleIdentifier (use an id your signing identity may sign)")
+    set(NDS_IOS_APP_NAME "NDS Recomp" CACHE STRING "Home-screen name")
+    set(NDS_IOS_GAME_CONFIG "" CACHE FILEPATH
+        "Optional game.toml copied into the bundle as game.toml")
+    if(NOT NDS_SDL_BACKEND STREQUAL "NONE")
+    target_sources(nds_runner PRIVATE src/ios_launch.mm)
+    set_target_properties(nds_runner PROPERTIES
+        MACOSX_BUNDLE TRUE
+        MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_LIST_DIR}/ios/Info.plist.in"
+        MACOSX_BUNDLE_GUI_IDENTIFIER "${NDS_IOS_BUNDLE_ID}"
+        MACOSX_BUNDLE_BUNDLE_NAME "${NDS_IOS_APP_NAME}"
+        MACOSX_BUNDLE_SHORT_VERSION_STRING "${PROJECT_VERSION}"
+        MACOSX_BUNDLE_BUNDLE_VERSION "${PROJECT_VERSION}"
+        XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2")
+    if(NDS_IOS_GAME_CONFIG)
+        target_sources(nds_runner PRIVATE "${NDS_IOS_GAME_CONFIG}")
+        set_source_files_properties("${NDS_IOS_GAME_CONFIG}" PROPERTIES
+            MACOSX_PACKAGE_LOCATION Resources)
+    endif()
+    else()
+        # Headless (no UIKit): a plain executable, for `simctl spawn` testing.
+        set_target_properties(nds_runner PROPERTIES MACOSX_BUNDLE FALSE)
+    endif()
+endif()
 
 find_package(Python3 COMPONENTS Interpreter QUIET)
 
