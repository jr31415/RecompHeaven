diff --git a/runner/src/ios_launch.mm b/runner/src/ios_launch.mm
new file mode 100644
index 0000000..cfc33df
--- /dev/null
+++ b/runner/src/ios_launch.mm
@@ -0,0 +1,83 @@
+// iOS/iPadOS entry point.
+//
+// SDL3's UIKit backend owns UIApplicationMain; SDL_RunApp starts it and calls
+// back on the main thread once the app is up. The runner's own main() is
+// compiled as nds_runner_main() on this platform. With no arguments (a normal
+// launch from the home screen) we synthesize the same command line the
+// desktop launcher uses, rooted in the app's Documents folder, which the user
+// reaches through the Files app (UIFileSharingEnabled).
+#import <Foundation/Foundation.h>
+#import <TargetConditionals.h>
+
+#if TARGET_OS_IOS
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_main.h>
+
+#include <string>
+#include <vector>
+
+extern "C++" int nds_runner_main(int argc, char** argv);
+
+namespace {
+
+std::string documents_dir() {
+    NSArray* dirs = NSSearchPathForDirectoriesInDomains(
+        NSDocumentDirectory, NSUserDomainMask, YES);
+    return std::string([dirs.firstObject fileSystemRepresentation]);
+}
+
+// First *.nds in Documents, preferring a file called game.nds.
+std::string find_rom(const std::string& docs) {
+    NSFileManager* fm = [NSFileManager defaultManager];
+    NSString* nsdocs = [NSString stringWithUTF8String:docs.c_str()];
+    NSString* preferred = [nsdocs stringByAppendingPathComponent:@"game.nds"];
+    if ([fm fileExistsAtPath:preferred]) return std::string([preferred UTF8String]);
+    for (NSString* name in [fm contentsOfDirectoryAtPath:nsdocs error:nil]) {
+        if ([[name pathExtension] caseInsensitiveCompare:@"nds"] == NSOrderedSame)
+            return std::string([[nsdocs stringByAppendingPathComponent:name]
+                UTF8String]);
+    }
+    return {};
+}
+
+std::string bundle_file(const char* name, const char* ext) {
+    NSString* p = [[NSBundle mainBundle] pathForResource:[NSString stringWithUTF8String:name]
+                                                  ofType:[NSString stringWithUTF8String:ext]];
+    return p ? std::string([p UTF8String]) : std::string();
+}
+
+int run(int argc, char** argv) {
+    if (argc > 1) return nds_runner_main(argc, argv);  // explicit args win
+    const std::string docs = documents_dir();
+    chdir(docs.c_str());
+    const std::string rom = find_rom(docs);
+    if (rom.empty()) {
+        SDL_ShowSimpleMessageBox(
+            SDL_MESSAGEBOX_ERROR, "ROM not found",
+            "Copy your Rhythm Heaven .nds file into this app's folder using "
+            "the Files app (On My iPad > this app), then reopen it.",
+            nullptr);
+        return 1;
+    }
+    std::vector<std::string> a = {argv[0], ".", "--interactive", "--freebios",
+                                  "--generated-firmware", "--boot", "direct",
+                                  "--rom", rom, "--save-path",
+                                  docs + "/game.sav",
+                                  "--coverage-manifest",
+                                  docs + "/coverage-session.json"};
+    std::string cfg = bundle_file("game", "toml");
+    if (!cfg.empty()) { a.push_back("--config"); a.push_back(cfg); }
+    std::vector<char*> av;
+    for (auto& s : a) av.push_back(s.data());
+    av.push_back(nullptr);
+    return nds_runner_main(static_cast<int>(a.size()), av.data());
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    return SDL_RunApp(argc, argv, run, nullptr);
+}
+
+#endif  // TARGET_OS_IOS
