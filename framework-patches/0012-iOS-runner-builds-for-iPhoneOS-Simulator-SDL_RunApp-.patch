+// pthread with an explicit stack; the join() surface matches std::thread.
+class BigStackThread {
+public:
+    explicit BigStackThread(std::function<void()> fn,
+                            size_t stack_bytes = size_t{64} << 20)
+        : fn_(std::move(fn)) {
+        pthread_attr_t attr;
+        pthread_attr_init(&attr);
+        pthread_attr_setstacksize(&attr, stack_bytes);
+        started_ = pthread_create(&thread_, &attr, &BigStackThread::entry,
+                                  this) == 0;
+        pthread_attr_destroy(&attr);
+        if (!started_) fn_();  // no thread available: run inline
+    }
+    void join() {
+        if (started_) pthread_join(thread_, nullptr);
+        started_ = false;
+    }
+    ~BigStackThread() { join(); }
+    BigStackThread(const BigStackThread&) = delete;
+    BigStackThread& operator=(const BigStackThread&) = delete;
+
+private:
+    static void* entry(void* self) {
+        static_cast<BigStackThread*>(self)->fn_();
+        return nullptr;
+    }
+    std::function<void()> fn_;
+    pthread_t thread_{};
+    bool started_ = false;
+};
+
 // Run `fn` on the main (SDL) thread. Inline when threading is off or when
 // already on it. `wait` blocks the caller until it has run.
 void run_on_main(std::function<void()> fn, bool wait) {
@@ -5015,7 +5048,10 @@ int nds_run_interactive_frontend(const NdsFrontendOptions& initial_options) {
             std::fprintf(stderr,
                          "[sdl] present thread: the main thread only pumps "
                          "input; the vsync'd present runs on its own thread\n");
-        std::thread worker([&]() {
+        // The recompiled dispatch nests deeply (see the -stack_size note in
+        // CMakeLists.txt) and iOS secondary threads default to 512 KB, so the
+        // emulation thread gets an explicit stack.
+        BigStackThread worker([&]() {
             sdl_set_thread_priority_high();
             emulation_loop();
             presenter.worker_done.store(true);
@@ -5490,6 +5526,7 @@ uint32_t nds_frontend_frame_digests(uint64_t from, uint32_t max,
     return copied;
 }
 
