+// "x,y,frames;x,y,frames;..." : press at each point for that many frames, then release. Runs on
+// its own thread so a swipe keeps its frame timing regardless of debug-socket round trips.
+bool nds_frontend_debug_touch_path(const char* path) {
+    if (!path) return false;
+    std::vector<std::array<int, 3>> steps;
+    for (const char* p = path; *p;) {
+        int x = 0, y = 0, n = 0, used = 0;
+        if (std::sscanf(p, "%d,%d,%d%n", &x, &y, &n, &used) < 3) break;
+        steps.push_back({x, y, n});
+        p += used;
+        if (*p == ';') ++p;
+    }
+    if (steps.empty()) return false;
+    std::thread([steps]() {
+        for (const auto& st : steps) {
+            nds_frontend_debug_touch(static_cast<uint16_t>(st[0]), static_cast<uint16_t>(st[1]), true);
+            std::this_thread::sleep_for(std::chrono::microseconds(st[2] * 16700));
+        }
+        nds_frontend_debug_touch(static_cast<uint16_t>(steps.back()[0]),
+                                 static_cast<uint16_t>(steps.back()[1]), false);
+    }).detach();
+    return true;
+}
