+#if defined(NDS_HAVE_SDL3)
+constexpr uint32_t kFingerPointerTag = 0x40000000u;
+// Direct-touch fingers become left-button pointer events whose `which` carries the finger id,
+// so the handler can tell pointers apart. Trackpads (indirect devices) keep SDL's mouse path.
+void finger_to_pointer(SDL_Event& e) {
+    if (e.type != SDL_EVENT_FINGER_DOWN && e.type != SDL_EVENT_FINGER_UP &&
+        e.type != SDL_EVENT_FINGER_MOTION)
+        return;
+    if (SDL_GetTouchDeviceType(e.tfinger.touchID) != SDL_TOUCH_DEVICE_DIRECT) return;
+    SDL_Window* window = SDL_GetWindowFromID(e.tfinger.windowID);
+    if (!window) return;
+    int w = 0, h = 0;
+    SDL_GetWindowSize(window, &w, &h);
+    const float x = e.tfinger.x * static_cast<float>(w), y = e.tfinger.y * static_cast<float>(h);
+    const uint32_t id = kFingerPointerTag | static_cast<uint32_t>(e.tfinger.fingerID & 0xFFFFFu);
+    const uint32_t wid = e.tfinger.windowID;
+    const uint64_t ts = e.tfinger.timestamp;
+    const int kind = e.type == SDL_EVENT_FINGER_DOWN ? 0 : e.type == SDL_EVENT_FINGER_UP ? 1 : 2;
+    SDL_zero(e);
+    if (kind == 2) {
+        e.motion.type = SDL_EVENT_MOUSE_MOTION; e.motion.timestamp = ts;
+        e.motion.windowID = wid; e.motion.which = id; e.motion.state = SDL_BUTTON_LMASK;
+        e.motion.x = x; e.motion.y = y;
+    } else {
+        e.button.type = kind == 0 ? SDL_EVENT_MOUSE_BUTTON_DOWN : SDL_EVENT_MOUSE_BUTTON_UP;
+        e.button.timestamp = ts; e.button.windowID = wid; e.button.which = id;
+        e.button.button = SDL_BUTTON_LEFT; e.button.down = kind == 0; e.button.clicks = 1;
+        e.button.x = x; e.button.y = y;
+    }
+}
+uint64_t pointer_id(const SDL_Event& e) {
+    return 1u + (e.type == SDL_EVENT_MOUSE_MOTION ? e.motion.which : e.button.which);
+}
+#else
+void finger_to_pointer(SDL_Event&) {}
+uint64_t pointer_id(const SDL_Event&) { return 1; }
+#endif
