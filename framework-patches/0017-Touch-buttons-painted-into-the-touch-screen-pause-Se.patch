+
+namespace {
+constexpr int kW = 256, kH = 192;
+
+void px_view(uint32_t* raw, int rotation, int vx, int vy, uint32_t argb) {
+    if (vx < 0 || vy < 0 || vx >= nds_touch_view_width(rotation) ||
+        vy >= nds_touch_view_height(rotation))
+        return;
+    int rx, ry;
+    nds_touch_view_to_raw(rotation, vx, vy, &rx, &ry);
+    raw[ry * kW + rx] = argb;
+}
+
+void rect_view(uint32_t* raw, int rotation, int x, int y, int w, int h, uint32_t c) {
+    for (int j = 0; j < h; ++j)
+        for (int i = 0; i < w; ++i) px_view(raw, rotation, x + i, y + j, c);
+}
+
+// Colours sampled from the game's own "Back"/"Skip" buttons.
+constexpr uint32_t kOutline = 0xFF000000, kFill = 0xFF4DFFFF, kHighlight = 0xFFF3FFFF,
+                   kShade1 = 0xFF00E7B6, kShade2 = 0xFF00B6A6, kInk = 0xFF008F84,
+                   kWhite = 0xFFFFFFFF;
+
+// 3x5 glyphs for the label.
+const char* glyph(char c) {
+    switch (c) {
+        case 'B': return "110101110101110";
+        case 'E': return "111100110100111";
+        case 'N': return "101111111101101";
+        case 'D': return "110101101101110";
+        default:  return "000000000000000";
+    }
+}
+
+void draw_text(uint32_t* raw, int rotation, int x, int y, const char* s, uint32_t c) {
+    for (; *s; ++s, x += 4) {
+        const char* g = glyph(*s);
+        for (int j = 0; j < 5; ++j)
+            for (int i = 0; i < 3; ++i)
+                if (g[j * 3 + i] == '1') px_view(raw, rotation, x + i, y + j, c);
+    }
+}
+}  // namespace
+
+int nds_touch_view_width(int r) { return (r == 90 || r == 270) ? kH : kW; }
+int nds_touch_view_height(int r) { return (r == 90 || r == 270) ? kW : kH; }
+
+void nds_touch_raw_to_view(int r, int x, int y, int* vx, int* vy) {
+    switch (r) {
+        case 90:  *vx = kH - 1 - y; *vy = x; break;
+        case 180: *vx = kW - 1 - x; *vy = kH - 1 - y; break;
+        case 270: *vx = y; *vy = kW - 1 - x; break;
+        default:  *vx = x; *vy = y; break;
+    }
+}
+
+void nds_touch_view_to_raw(int r, int vx, int vy, int* x, int* y) {
+    switch (r) {
+        case 90:  *x = vy; *y = kH - 1 - vx; break;
+        case 180: *x = kW - 1 - vx; *y = kH - 1 - vy; break;
+        case 270: *x = kW - 1 - vy; *y = vx; break;
+        default:  *x = vx; *y = vy; break;
+    }
+}
+
+NdsViewRect nds_button_view_rect(int rotation, const NdsTouchButtonDef& d) {
+    const int vw = nds_touch_view_width(rotation), vh = nds_touch_view_height(rotation);
+    const bool right = d.corner.find("right") != std::string::npos;
+    const bool bottom = d.corner.find("bottom") != std::string::npos;
+    return {right ? vw - d.width : 0, bottom ? vh - d.height : 0, d.width, d.height};
+}
+
+bool nds_button_hit(int rotation, const NdsTouchButtonDef& d, int rx, int ry) {
+    int vx, vy;
+    nds_touch_raw_to_view(rotation, rx, ry, &vx, &vy);
+    const NdsViewRect r = nds_button_view_rect(rotation, d);
+    return vx >= r.x && vx < r.x + r.w && vy >= r.y && vy < r.y + r.h;
+}
+
+void nds_button_draw(uint32_t* raw, int rotation, const NdsTouchButtonDef& d, bool pressed) {
+    const NdsViewRect r = nds_button_view_rect(rotation, d);
+    const bool right = d.corner.find("right") != std::string::npos;
+    const bool bottom = d.corner.find("bottom") != std::string::npos;
+    // A tab flush with the screen corner: the outline is only drawn on the sides facing
+    // into the screen, the rest runs off the edge, so no touch area is wasted on margin.
+    const uint32_t fill = pressed ? kShade1 : kFill;
+    rect_view(raw, rotation, r.x, r.y, r.w, r.h, fill);
+    // inner-facing outline
+    const int ox = right ? r.x : r.x + r.w - 1;
+    rect_view(raw, rotation, ox, r.y, 1, r.h, kOutline);
+    const int oy = bottom ? r.y : r.y + r.h - 1;
+    rect_view(raw, rotation, r.x, oy, r.w, 1, kOutline);
+    // shaded edge toward the screen edge (the game's buttons carry one on the far side)
+    if (!pressed) {
+        const int sx = right ? r.x + r.w - 4 : r.x + 1;
+        rect_view(raw, rotation, sx, r.y + 1, 3, r.h - 2, kShade1);
+        rect_view(raw, rotation, right ? sx + 2 : sx, r.y + 1, 1, r.h - 2, kShade2);
+        rect_view(raw, rotation, r.x + 2, r.y + 1, r.w - 7, 1, kHighlight);
+    }
+    const uint32_t ink = pressed ? kWhite : kInk;
+    if (d.icon == "pause") {
+        const int cx = r.x + (r.w - 9) / 2 - (right ? 1 : 0), cy = r.y + (r.h - 9) / 2;
+        rect_view(raw, rotation, cx, cy, 3, 9, ink);
+        rect_view(raw, rotation, cx + 6, cy, 3, 9, ink);
+    } else if (d.icon == "bend") {
+        const int ix = r.x + 4, iy = r.y + (r.h - 9) / 2;
+        // rising curved arrow
+        const int pts[][2] = {{0, 8}, {1, 7}, {2, 6}, {3, 5}, {4, 4}, {5, 3}, {6, 2}};
+        for (auto& p : pts) rect_view(raw, rotation, ix + p[0], iy + p[1], 2, 1, ink);
+        rect_view(raw, rotation, ix + 4, iy, 5, 1, ink);
+        rect_view(raw, rotation, ix + 8, iy, 1, 5, ink);
+        draw_text(raw, rotation, r.x + 14, r.y + (r.h - 5) / 2, "BEND", ink);
+    }
+}
+
+uint64_t nds_fnv1a64(const uint8_t* p, size_t n) {
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < n; ++i) { h ^= p[i]; h *= 1099511628211ull; }
+    return h;
+}
diff --git a/runner/src/touch_buttons.h b/runner/src/touch_buttons.h
new file mode 100644
index 0000000..3315b03
--- /dev/null
+++ b/runner/src/touch_buttons.h
@@ -0,0 +1,53 @@
+#pragma once
+// On-screen buttons painted into the DS touch screen itself.
+//
+// They are drawn in the game's own button style (black outline, cyan fill, teal
+// shaded edge) straight into the bottom-screen pixel buffer, so they scale, rotate
+// and flip with the game exactly like its own UI, and a press maps to DS keys. The
+// title decides when each one exists: scenes are recognised by fingerprinting guest
+// RAM (the overlay that is resident), configured per title in game.toml.
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct NdsSceneDef {
+    std::string name;
+    uint32_t addr = 0;              // guest address fingerprinted
+    uint32_t len = 0;               // bytes hashed (FNV-1a 64)
+    std::vector<uint64_t> hashes;   // any match activates the scene
+};
+
+struct NdsTouchButtonDef {
+    std::string name;
+    std::string icon;               // "pause" | "bend"
+    std::string corner = "top-right";   // in the player's upright view of the touch screen
+    int width = 20;                 // DS pixels, in view orientation
+    int height = 20;
+    uint16_t keys = 0;              // DS key bits (1<<2 Select, 1<<8 R, 1<<9 L, ...)
+    std::vector<std::string> scenes;    // visible when any is active; empty = always
+};
+
+struct NdsTouchButtonConfig {
+    std::vector<NdsTouchButtonDef> buttons;
+    std::vector<NdsSceneDef> scenes;
+    bool empty() const { return buttons.empty(); }
+};
+
+// The touch screen is 256x192 raw. `rotation` is the clockwise host rotation applied to
+// the raw frame (0/90/180/270); the player sees the rotated image.
+struct NdsViewRect { int x, y, w, h; };   // in the player's view of the touch screen
+
+int nds_touch_view_width(int rotation);   // 256 or 192
+int nds_touch_view_height(int rotation);  // 192 or 256
+void nds_touch_raw_to_view(int rotation, int rx, int ry, int* vx, int* vy);
+void nds_touch_view_to_raw(int rotation, int vx, int vy, int* rx, int* ry);
+
+NdsViewRect nds_button_view_rect(int rotation, const NdsTouchButtonDef& def);
+bool nds_button_hit(int rotation, const NdsTouchButtonDef& def, int raw_x, int raw_y);
+
+// Paint the button into a 256x192 ARGB8888 raw touch-screen buffer.
+void nds_button_draw(uint32_t* raw_pixels, int rotation, const NdsTouchButtonDef& def,
+                     bool pressed);
+
+uint64_t nds_fnv1a64(const uint8_t* data, size_t n);
diff --git a/runner/tests/touch_buttons_test.cpp b/runner/tests/touch_buttons_test.cpp
new file mode 100644
index 0000000..0cef165
--- /dev/null
+++ b/runner/tests/touch_buttons_test.cpp
@@ -0,0 +1,34 @@
+#include "../src/touch_buttons.h"
+#include <cstdio>
+#include <cstdlib>
+
+int main() {
+    int fails = 0;
+    for (int r : {0, 90, 180, 270}) {
+        for (int y = 0; y < 192; y += 7)
+            for (int x = 0; x < 256; x += 5) {
+                int vx, vy, rx, ry;
+                nds_touch_raw_to_view(r, x, y, &vx, &vy);
+                nds_touch_view_to_raw(r, vx, vy, &rx, &ry);
+                if (rx != x || ry != y || vx < 0 || vy < 0 || vx >= nds_touch_view_width(r) ||
+                    vy >= nds_touch_view_height(r)) { ++fails; }
+            }
+        NdsTouchButtonDef d; d.corner = "top-right"; d.width = 20; d.height = 20;
+        // The corner pixel of the view must hit; one pixel outside must not.
+        const NdsViewRect vr = nds_button_view_rect(r, d);
+        int rx, ry;
+        nds_touch_view_to_raw(r, vr.x + vr.w - 1, 0, &rx, &ry);
+        if (!nds_button_hit(r, d, rx, ry)) ++fails;
+        nds_touch_view_to_raw(r, vr.x - 1, 0, &rx, &ry);
+        if (nds_button_hit(r, d, rx, ry)) ++fails;
+        static uint32_t buf[256 * 192];
+        d.icon = "pause"; nds_button_draw(buf, r, d, false);
+        d.icon = "bend"; d.corner = "bottom-right"; d.width = 34; nds_button_draw(buf, r, d, true);
+    }
+    // top-right of the player's view for 90 degrees is raw (0,0); for 270 raw (255,191)
+    NdsTouchButtonDef t; t.corner = "top-right"; int vx, vy;
+    nds_touch_raw_to_view(90, 0, 0, &vx, &vy); if (vx != 191 || vy != 0) ++fails;
+    nds_touch_raw_to_view(270, 255, 191, &vx, &vy); if (vx != 191 || vy != 0) ++fails;
+    std::printf(fails ? "FAIL %d\n" : "touch_buttons_test ok\n", fails);
+    return fails ? 1 : 0;
+}
