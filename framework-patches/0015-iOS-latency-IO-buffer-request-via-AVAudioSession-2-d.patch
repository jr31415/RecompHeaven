diff --git a/runner/src/ios_audio.mm b/runner/src/ios_audio.mm
new file mode 100644
index 0000000..4da508b
--- /dev/null
+++ b/runner/src/ios_audio.mm
@@ -0,0 +1,63 @@
+// iOS audio-session and display latency tuning. The OS default IO buffer is
+// ~1024 frames (about 21 ms at 48 kHz); SDL does not shrink it, so ask here.
+#import <TargetConditionals.h>
+
+#if TARGET_OS_IOS
+
+#import <AVFAudio/AVFAudio.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+
+#include "audio_device_info.h"
+
+bool nds_audio_set_os_buffer_frames(uint32_t frames, uint32_t* applied) {
+    @autoreleasepool {
+        AVAudioSession* session = [AVAudioSession sharedInstance];
+        const double rate = session.sampleRate > 0 ? session.sampleRate : 48000.0;
+        NSError* err = nil;
+        [session setPreferredIOBufferDuration:static_cast<double>(frames) / rate
+                                        error:&err];
+        if (err) std::fprintf(stderr, "[ios-audio] preferred IO buffer: %s\n",
+                              err.localizedDescription.UTF8String);
+        err = nil;
+        [session setActive:YES error:&err];
+        if (applied)
+            *applied = static_cast<uint32_t>(
+                std::lround(session.IOBufferDuration * session.sampleRate));
+        return err == nil;
+    }
+}
+
+bool nds_audio_system_info(NdsAudioSystemInfo* out) {
+    if (!out) return false;
+    *out = NdsAudioSystemInfo{};
+    @autoreleasepool {
+        AVAudioSession* s = [AVAudioSession sharedInstance];
+        out->ok = true;
+        out->sample_rate = s.sampleRate;
+        out->buffer_frames =
+            static_cast<uint32_t>(std::lround(s.IOBufferDuration * s.sampleRate));
+        out->device_latency =
+            static_cast<uint32_t>(std::lround(s.outputLatency * s.sampleRate));
+        AVAudioSessionPortDescription* port =
+            s.currentRoute.outputs.firstObject;
+        if (port)
+            std::strncpy(out->name, port.portName.UTF8String,
+                         sizeof(out->name) - 1);
+    }
+    return true;
+}
+
+void nds_ios_tune_display(void* layer) {
+    if (!layer) return;
+    CAMetalLayer* l = (__bridge CAMetalLayer*)layer;
+    if ([l isKindOfClass:[CAMetalLayer class]]) {
+        l.maximumDrawableCount = 2;
+        l.presentsWithTransaction = NO;
+    }
+}
+
+#endif
