+// Threaded presenter (opt-in, NDS_THREADED_PRESENT=1).
+//
+// SDL's renderer and window APIs belong to the main thread. The default
+// frontend therefore emulates, paces audio and presents on that one thread, so
+// a vsync-blocking present stalls the audio clock: the loop is locked to the
+// display rate (60.0 Hz) while the DS makes 59.83 Hz of audio, every missed
+// vblank costs a whole frame of audio, and the queue starves.
+//
+// In this mode the main thread owns SDL (events, the vsync'd present, window
+// calls) and a worker thread runs the unchanged emulation loop. The worker never
+// waits on the display: it publishes the newest composed frame to a mailbox
+// (latest wins, so a late presenter drops a frame instead of blocking audio),
+// takes input from a queue the main thread fills, and routes the few
+// main-thread-only SDL calls through run_on_main().
+struct ThreadedPresenter {
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::deque<SDL_Event> events;                   // main -> worker
+    std::deque<std::function<void()>> tasks;        // worker -> main
+    std::vector<uint32_t> pix[2];                   // worker -> main
+    int width[2]{256, 256};
+    uint64_t seq = 0;
+    bool stylus_visible = false;
+    float stylus_x = 0.0f;
+    float stylus_y = 0.0f;
+    std::string notice;
+    std::atomic<bool> worker_done{false};
+    std::atomic<uint64_t> last_swap_ticks{0};
+    std::atomic<uint64_t> last_present_ticks{0};
+    std::atomic<uint64_t> presented{0};
+};
+bool sdl_set_relative_mouse_mode_impl(SDL_Window* window, bool enabled);
+ThreadedPresenter* g_presenter = nullptr;
+std::thread::id g_main_thread_id;
+
+// Run `fn` on the main (SDL) thread. Inline when threading is off or when
+// already on it. `wait` blocks the caller until it has run.
+void run_on_main(std::function<void()> fn, bool wait) {
+    if (!g_presenter || std::this_thread::get_id() == g_main_thread_id) {
+        fn();
+        return;
+    }
+    if (!wait) {
+        {
+            std::lock_guard<std::mutex> lock(g_presenter->mutex);
+            g_presenter->tasks.push_back(std::move(fn));
+        }
+        g_presenter->cv.notify_one();
+        return;
+    }
+    auto done = std::make_shared<std::promise<void>>();
+    std::future<void> finished = done->get_future();
+    {
+        std::lock_guard<std::mutex> lock(g_presenter->mutex);
+        g_presenter->tasks.push_back([fn = std::move(fn), done]() mutable {
+            fn();
+            done->set_value();
+        });
+    }
+    g_presenter->cv.notify_one();
+    finished.wait();
+}
+
 bool sdl_set_relative_mouse_mode(SDL_Window* window, bool enabled) {
+    bool ok = false;
+    run_on_main([&]() { ok = sdl_set_relative_mouse_mode_impl(window, enabled); },
+                true);
+    return ok;
+}
+
+void sdl_capture_mouse(bool enabled) {
+    run_on_main([enabled]() { SDL_CaptureMouse(enabled ? SDL_TRUE : SDL_FALSE); },
+                false);
+}
