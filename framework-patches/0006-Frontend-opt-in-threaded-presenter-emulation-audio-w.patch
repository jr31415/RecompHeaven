+    };  // emulation_loop
+
+    if (threaded) {
+        std::thread worker([&]() {
+            sdl_set_thread_priority_high();
+            emulation_loop();
+            presenter.worker_done.store(true);
+            presenter.cv.notify_all();
+        });
+        std::vector<uint32_t> local[2];
+        int local_width[2]{kScreenWidth, kScreenWidth};
+        uint64_t seen = 0;
+        bool stylus_visible = false;
+        float stylus_x = 0.0f;
+        float stylus_y = 0.0f;
+        std::string notice;
+        for (;;) {
+            SDL_Event queued_event{};
+            while (SDL_PollEvent(&queued_event)) {
+                convert_mouse_event_to_logical_coordinates(queued_event,
+                                                           presentation);
+                unrotate_mouse_event(queued_event, presentation);
+                std::lock_guard<std::mutex> lock(presenter.mutex);
+                presenter.events.push_back(queued_event);
+            }
+            for (;;) {
+                std::function<void()> task;
+                {
+                    std::lock_guard<std::mutex> lock(presenter.mutex);
+                    if (presenter.tasks.empty()) break;
+                    task = std::move(presenter.tasks.front());
+                    presenter.tasks.pop_front();
+                }
+                task();
+            }
+            if (presenter.worker_done.load()) break;
+            bool have_frame = false;
+            {
+                std::unique_lock<std::mutex> lock(presenter.mutex);
+                if (presenter.seq == seen && presenter.tasks.empty())
+                    presenter.cv.wait_for(lock, std::chrono::milliseconds(2));
+                if (presenter.seq != seen) {
+                    local[0] = presenter.pix[0];
+                    local[1] = presenter.pix[1];
+                    local_width[0] = presenter.width[0];
+                    local_width[1] = presenter.width[1];
+                    stylus_visible = presenter.stylus_visible;
+                    stylus_x = presenter.stylus_x;
+                    stylus_y = presenter.stylus_y;
+                    notice = presenter.notice;
+                    seen = presenter.seq;
+                    have_frame = true;
+                }
+            }
+            if (have_frame && !local[0].empty() && !local[1].empty()) {
+                const PresentationTicks t = present_screens(
+                    presentation, local[0].data(), local_width[0],
+                    local[1].data(), local_width[1], nullptr, stylus_visible,
+                    stylus_x, stylus_y, notice.empty() ? nullptr
+                                                       : notice.c_str());
+                presenter.last_swap_ticks.store(t.swap,
+                                                std::memory_order_relaxed);
+                presenter.last_present_ticks.store(
+                    t.upload + t.draw + t.swap, std::memory_order_relaxed);
+                presenter.presented.fetch_add(1, std::memory_order_relaxed);
+            }
+        }
